# All optional. Gideon runs with none of these set.

# testnet (default) or mainnet
GIDEON_NETWORK=testnet

# Sign check receipts (R12). Create one with: npm run gideon -- keygen
GIDEON_RECEIPT_KEY=

# Paid / private RPC adapter (off by default; the free FastNEAR endpoints are used otherwise)
GIDEON_RPC_URL_MAINNET=
GIDEON_RPC_URL_TESTNET=
GIDEON_RPC_API_KEY=

# NEAR AI plain-language explainer (off by default; built-in text otherwise)
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.2
