{
  "name": "gideon-near",
  "private": true,
  "version": "0.1.0",
  "description": "Gideon: a pre-send safety check for NEAR. Stops sends you can't take back.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/core",
    "packages/sources",
    "packages/cli",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @gideon/core -w @gideon/sources -w @gideon/cli",
    "postinstall": "npm run build",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "record": "node scripts/record-fixtures.mjs",
    "dev:web": "npm run dev -w @gideon/web",
    "build:web": "npm run build -w @gideon/web",
    "preview:web": "npm run preview -w @gideon/web",
    "gideon": "node packages/cli/dist/index.js",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/sources/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "@types/node": "^22.0.0"
  }
}
