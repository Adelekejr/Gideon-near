{
  "manifest_version": 3,
  "name": "Gideon: NEAR pre-send check",
  "short_name": "Gideon",
  "version": "0.0.1",
  "description": "Checks a NEAR address the moment you paste it, before you send.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gideon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"]
}
