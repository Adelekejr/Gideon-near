{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@gideon/core": ["../../packages/core/src/index.ts"],
      "@gideon/sources": ["../../packages/sources/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
